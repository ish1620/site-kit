{
  "name": "site-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared building blocks for ishokutani.com and calle.ishokutani.com",
  "type": "module",
  "keywords": ["astro-component"],
  "exports": {
    "./i18n": { "types": "./src/i18n.d.ts", "default": "./src/i18n.js" },
    "./markdown": { "types": "./src/markdown.d.ts", "default": "./src/markdown.js" },
    "./routes": { "types": "./src/routes.d.ts", "default": "./src/routes.js" },
    "./SiteHead.astro": "./src/SiteHead.astro",
    "./SkipLink.astro": "./src/SkipLink.astro",
    "./SiteHeader.astro": "./src/SiteHeader.astro",
    "./LanguageNav.astro": "./src/LanguageNav.astro"
  },
  "files": ["src"],
  "peerDependencies": {
    "astro": "^7.0.0"
  }
}
